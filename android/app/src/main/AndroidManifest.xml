<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DeepL translations. Nothing else goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Adding and updating cards in AnkiDroid. -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <!-- Android 11+ hides other apps unless they are listed here. -->
    <queries>
        <package android:name="com.ichi2.anki" />
    </queries>

    <application
        android:name=".AllreadsApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Allreads">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
