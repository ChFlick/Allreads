<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- DeepL translations, dictionary and book-list downloads, and books from "Find a book". Nothing else goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To ask before a dictionary download on mobile data. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Adding and updating cards in AnkiDroid. -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <!-- Android 11+ hides other apps unless they are listed here. -->
    <queries>
        <package android:name="com.ichi2.anki" />
        <!-- To show "Look up in the web dictionary" only when a browser can open it. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".AllreadsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        tools:replace="android:label"
        android:supportsRtl="true"
        android:theme="@style/Theme.Allreads">
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Allreads.Starting"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share → Allreads" from a browser or any app: a web page's link or some text to import. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
